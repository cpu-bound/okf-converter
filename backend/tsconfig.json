{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "useDefineForClassFields": false,
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ]
}