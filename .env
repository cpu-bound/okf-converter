# ---------------------------------------------------------------------------
# Configuración de OKF Converter.
#
# Docker Compose carga este archivo automáticamente, de modo que
# `docker compose up` (o `make up`) sigue funcionando con un solo comando
# desde un clon limpio, sin pasos previos.
#
# Los valores aquí son de DESARROLLO LOCAL y están versionados a propósito,
# para que el despliegue sea reproducible. Para un entorno real, sobrescribir
# estas variables desde el entorno o con un `.env.local` (ver README);
# `JWT_SECRET` y todas las contraseñas deben cambiarse.
# ---------------------------------------------------------------------------

# --- Aplicación ---------------------------------------------------------
# APP_ENV=production activa el flag Secure de la cookie de sesión, que
# requiere HTTPS: dejarlo en development para el stack local sobre HTTP.
APP_ENV=development

# Puerto del host donde queda publicada la aplicación.
FRONTEND_PORT=8080

# Origen del navegador. Se usa para el CORS de la API y de MinIO, así que
# debe coincidir con FRONTEND_PORT.
FRONTEND_URL=http://localhost:8080

# --- Autenticación ------------------------------------------------------
JWT_SECRET=dev-only-secret-change-me-before-any-real-deployment

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=okf
POSTGRES_USER=okf
POSTGRES_PASSWORD=okf_password

# --- RabbitMQ -----------------------------------------------------------
RABBITMQ_USER=okf
RABBITMQ_PASSWORD=okf_password

# Puertos del host: AMQP (para inspeccionar la cola desde fuera) y la
# consola de administración.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# --- MinIO --------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_BUCKET=user-files

# Puerto del host para la API S3. El navegador sigue directamente las URLs
# prefirmadas que la API firma contra este puerto, así que tiene que ser
# alcanzable desde fuera de la red de Docker.
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_ENDPOINT=localhost

# Consola web de MinIO.
MINIO_CONSOLE_PORT=9001

# --- Observabilidad -----------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
