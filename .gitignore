# System files
.DS_Store
Thumbs.db

# Configuración
#
# El `.env` real NO se versiona: es el archivo que cada quien edita, y es
# donde acabarían las credenciales de un despliegue de verdad. Lo que sí se
# versiona es `.env.example`, con valores de desarrollo local, para que un
# clon limpio arranque copiándolo.
.env
.env.local
.env.*.local
!.env.example

# Notas de trabajo, no parte de la entrega
preguntas-profesor.md
correo-profesor.md
pendientes.md
